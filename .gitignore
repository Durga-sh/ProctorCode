# ============================================================
#  .gitignore — Coding Exam Platform
#  Stack: Spring Boot (Maven) + React (Vite) + MySQL
# ============================================================

# ─── Secrets & Environment ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# ─── Backend: Maven / Spring Boot ───────────────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/*.log
backend/*.pid

# Eclipse / STS project files (already in backend root)
backend/.classpath
backend/.project
backend/.settings/
backend/.factorypath

# IntelliJ IDEA (if ever used for backend)
backend/.idea/
backend/*.iml

# ─── Frontend: Node / Vite / React ──────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/build/

# Vite / dotenv local overrides
frontend/*.local
frontend/.env
frontend/.env.*
!frontend/.env.example

# Frontend logs
frontend/logs/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ─── Database ────────────────────────────────────────────────
# Ignore generated SQL dumps — keep schema migration scripts
database/*.dump
database/*.bak

# ─── IDEs & Editors ─────────────────────────────────────────
# VS Code (keep shared workspace settings if desired)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# IntelliJ / JetBrains
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse
.classpath
.project
.settings/
.factorypath
bin/

# ─── OS Generated ────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encdata
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# Linux
*~

# ─── Misc ────────────────────────────────────────────────────
*.class
*.jar
!backend/src/**/*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
